// Pro Play Turf — Prisma schema.
// Slice 2 introduces the money core: User, Wallet, and an append-only,
// double-entry ledger. Slice 3 adds the league structure: Season, Division
// (tier), and League. Later slices add matches, cards, etc.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PLAYER
  REVIEWER
  ADMIN
  SYSTEM
}

// Buckets money can live in. AVAILABLE/ESCROW are cached on user wallets;
// HOUSE/PRIZE_POOL live on system wallets and are reconciled by summation.
enum Bucket {
  AVAILABLE
  ESCROW
  HOUSE
  PRIZE_POOL
}

model User {
  id          String            @id @default(cuid())
  email       String            @unique
  displayName String
  role        Role              @default(PLAYER)
  // Firebase Auth uid — the bridge to the Firestore member profile. Nullable so
  // system/seed accounts (which have no Firebase identity) remain valid.
  firebaseUid String?           @unique
  wallet      Wallet?
  entries     LeagueEntry[]
  homeMatches Match[]           @relation("HomeMatches")
  awayMatches Match[]           @relation("AwayMatches")
  submissions MatchSubmission[]
  proofs      MatchProof[]
  disputes    MatchDispute[]    @relation("DisputesRaised")
  createdAt   DateTime          @default(now())
}

model Wallet {
  id             String        @id @default(cuid())
  userId         String        @unique
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Caches of the ledger; only LedgerService may mutate these.
  availableCents BigInt        @default(0)
  escrowCents    BigInt        @default(0)
  currency       String        @default("USD")
  entries        LedgerEntry[]
  createdAt      DateTime      @default(now())
}

// Idempotency parent: one row per money action. Its id is the idempotency key —
// posting the same txnId twice is a no-op (unique PK collision => already applied).
model LedgerTransaction {
  id        String        @id
  reason    String // DEPOSIT | ADMIN_GRANT | ENTRY_HOLD | PRIZE | RAKE | PAYOUT | REFUND | ...
  refType   String?
  refId     String?
  createdAt DateTime      @default(now())
  entries   LedgerEntry[]
}

model LedgerEntry {
  id          String            @id @default(cuid())
  txnId       String
  txn         LedgerTransaction @relation(fields: [txnId], references: [id], onDelete: Cascade)
  walletId    String
  wallet      Wallet            @relation(fields: [walletId], references: [id])
  bucket      Bucket
  amountCents BigInt // signed; the sum of all entries for one txnId is exactly 0
  createdAt   DateTime          @default(now())

  @@index([walletId])
  @@index([txnId])
}

// ---------------------------------------------------------------------------
// Slice 3 — league structure. A Season contains ranked Divisions (tiers), each
// holding one or more Leagues that players buy into. No money lives here; the
// buy-in escrow + prize flows all run through LedgerService (Slices 4/8).
// ---------------------------------------------------------------------------

enum SeasonStatus {
  UPCOMING
  ACTIVE
  CLOSED
}

// The competitive ladder, low → high. Champions is the invite-only apex tier.
enum Tier {
  AMATEUR
  INTERMEDIATE
  ADVANCED
  ELITE
  CHAMPIONS
}

enum LeagueStatus {
  OPEN // accepting entries
  FILLING // near capacity
  LIVE // season underway, closed to new entries
  ENDED // settled
}

model Season {
  id        String       @id @default(cuid())
  name      String
  status    SeasonStatus @default(UPCOMING)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime     @default(now())
  divisions Division[]

  @@index([status])
}

model Division {
  id        String   @id @default(cuid())
  seasonId  String
  season    Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  name      String
  tier      Tier
  rank      Int // ordering within the season; higher = more prestigious
  leagues   League[]
  createdAt DateTime @default(now())

  @@index([seasonId])
}

model League {
  id         String        @id @default(cuid())
  divisionId String
  division   Division      @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  name       String
  buyInCents BigInt        @default(0) // 0 => a free league
  rakeBps    Int           @default(0) // basis points of the pool routed to HOUSE
  capacity   Int           @default(16)
  status     LeagueStatus  @default(OPEN)
  startsAt   DateTime?
  createdAt  DateTime      @default(now())
  entries    LeagueEntry[]
  matches    Match[]

  @@index([divisionId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Slice 4 — league entries. Joining holds the buy-in in ESCROW; the entry keeps
// the id of the ledger txn that placed the hold so the refund can reverse
// exactly that transaction. No money is cached here — the ledger stays truth.
// ---------------------------------------------------------------------------

enum EntryStatus {
  ACTIVE // holding escrow, competing
  REFUNDED // withdrew before the league started; escrow released
}

// ---------------------------------------------------------------------------
// Slice 5 — matches. There is no EA match API: truth is what both players
// submit, backed by proof, and adjudicated by humans when they disagree. A
// match therefore holds NO authoritative score until two submissions agree.
// ---------------------------------------------------------------------------

enum MatchStatus {
  SCHEDULED // fixture exists, not played
  LIVE // in progress
  AWAITING // one player has reported, waiting on the other
  VERIFIED // both reported the same score — this is the result
  UNDER_REVIEW // reports disagree or were flagged (Slice 6)
  DISPUTED // a player formally contested it (Slice 6)
  VOID // annulled by a reviewer
}

enum ProofKind {
  SCREENSHOT // uploaded image (needs blob storage; stubbed until then)
  STREAM_URL // Twitch/YouTube VOD link — needs no storage
}

model Match {
  id          String            @id @default(cuid())
  leagueId    String
  league      League            @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  round       Int
  homeUserId  String
  home        User              @relation("HomeMatches", fields: [homeUserId], references: [id], onDelete: Cascade)
  awayUserId  String
  away        User              @relation("AwayMatches", fields: [awayUserId], references: [id], onDelete: Cascade)
  status      MatchStatus       @default(SCHEDULED)
  // Only set once VERIFIED — an unverified match has no score, by design.
  homeScore   Int?
  awayScore   Int?
  scheduledAt DateTime?
  verifiedAt  DateTime?
  createdAt   DateTime          @default(now())
  submissions MatchSubmission[]
  proofs      MatchProof[]
  disputes    MatchDispute[]

  // One fixture per ordered pair per league.
  @@unique([leagueId, homeUserId, awayUserId])
  @@index([leagueId, status])
  @@index([homeUserId])
  @@index([awayUserId])
}

/**
 * One player's report of the result. Never overwritten — it is evidence.
 */
model MatchSubmission {
  id          String   @id @default(cuid())
  matchId     String
  match       Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  homeScore   Int
  awayScore   Int
  submittedAt DateTime @default(now())

  @@unique([matchId, userId])
  @@index([matchId])
}

model MatchProof {
  id        String    @id @default(cuid())
  matchId   String
  match     Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      ProofKind
  // For STREAM_URL this is the link; for SCREENSHOT it's the storage key/URL
  // handed back by ProofStorage.
  url       String
  createdAt DateTime  @default(now())

  @@index([matchId])
}

// ---------------------------------------------------------------------------
// Slice 6 — adjudication. Disagreements go to humans, and every decision that
// changes a result is written to an append-only AuditLog. Nothing here deletes
// evidence: a voided match keeps its reports and proofs.
// ---------------------------------------------------------------------------

enum DisputeStatus {
  OPEN // waiting on a reviewer
  UPHELD // the complaint was accepted; the result changed
  REJECTED // the complaint was dismissed; the result stands
}

model MatchDispute {
  id               String        @id @default(cuid())
  matchId          String
  match            Match         @relation(fields: [matchId], references: [id], onDelete: Cascade)
  raisedByUserId   String
  raisedBy         User          @relation("DisputesRaised", fields: [raisedByUserId], references: [id], onDelete: Cascade)
  reason           String
  evidenceUrl      String?
  status           DisputeStatus @default(OPEN)
  resolvedByUserId String?
  resolutionNote   String?
  createdAt        DateTime      @default(now())
  resolvedAt       DateTime?

  // One live complaint per player per match.
  @@unique([matchId, raisedByUserId])
  @@index([status])
  @@index([matchId])
}

/**
 * Append-only record of every consequential action. Never updated, never
 * deleted — it is the answer to "who changed this result, and why".
 */
model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String? // null when the system acted
  action      String // MATCH_VERIFIED | MATCH_VOIDED | DISPUTE_RAISED | ...
  entityType  String // "match" | "dispute" | "league" | ...
  entityId    String
  // Human-readable summary. Deliberately a string, not JSON: money is BigInt
  // and would not survive JSON serialisation intact.
  detail      String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

model LeagueEntry {
  id          String      @id @default(cuid())
  leagueId    String
  league      League      @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  // The ENTRY_HOLD txn that moved the buy-in AVAILABLE→ESCROW. Null only for
  // free leagues, where joining moves no money.
  escrowTxnId String?
  // Denormalised from League.buyInCents at join time: the buy-in can be edited
  // later, but the amount actually held must stay reversible to the cent.
  buyInCents  BigInt      @default(0)
  status      EntryStatus @default(ACTIVE)
  joinedAt    DateTime    @default(now())

  // One entry per player per league — the double-join guard, enforced by the DB.
  @@unique([leagueId, userId])
  @@index([leagueId, status])
  @@index([userId])
}
